  "description": "Arbitrium CLI — a multi-provider tool for adversarial robustness testing of LLM safety systems (academic / defensive red-teaming).",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "arbitrium": "./arbitrium.mjs",
    "arb": "./arbitrium.mjs"
  },
  "scripts": {
